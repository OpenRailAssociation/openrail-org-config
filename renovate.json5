{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>OpenRailAssociation/renovate-config"],
  "packageRules": [
    {
      "description": "Merge core dependency of this repo that might break things manually",
      "matchPackageNames": ["github-org-manager"],
      "automerge": false,
    },
  ]
}
